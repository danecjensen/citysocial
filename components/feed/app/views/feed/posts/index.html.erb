<%= render PlatformCore::Ui::PageHeaderComponent.new(
      title: "Home",
      subtitle: "News, conversations, and useful things happening around your city."
    ) %>

<div class="mx-auto max-w-3xl space-y-5">
  <%= render PlatformCore::Ui::CardComponent.new do %>
    <div class="mb-5 flex items-center gap-3">
      <%= render PlatformCore::Ui::AvatarComponent.new(user: current_user, size: :md, alt: "") %>
      <div>
        <h2 class="font-display text-xl font-black text-ink">Share with your city</h2>
        <p class="text-sm text-ink-muted">Start a conversation or bring an article, event, listing, or game into the feed.</p>
      </div>
    </div>
    <%= render "form", post: @composer, url: posts_path, method: :post, composer: true %>
  <% end %>

  <nav aria-label="Feed filters" class="flex flex-wrap gap-2">
    <%= render PlatformCore::Ui::ButtonComponent.new(
          variant: @filter.nil? ? :primary : :secondary,
          size: :sm,
          href: posts_path,
          pressed: @filter.nil?
        ) do %>Latest<% end %>
    <%= render PlatformCore::Ui::ButtonComponent.new(
          variant: @filter == "saved" ? :primary : :secondary,
          size: :sm,
          href: posts_path(filter: "saved"),
          pressed: @filter == "saved"
        ) do %>Saved<% end %>
  </nav>

  <% if @posts.any? %>
    <div class="space-y-5">
      <% @posts.each do |post| %>
        <%= render "post", post: post, author: @authors[post.author_id], detailed: false %>
      <% end %>
    </div>
  <% else %>
    <%= render PlatformCore::Ui::EmptyStateComponent.new(
          title: @filter == "saved" ? "No saved posts yet" : "Your home feed is ready",
          body: @filter == "saved" ? "Save useful posts and articles to find them here." :
            "Share the first update, or follow residents to bring their posts into your feed."
        ) %>
  <% end %>
</div>
