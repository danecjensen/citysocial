<%= render PlatformCore::Ui::PageHeaderComponent.new(
      title: "Edit post",
      subtitle: "Update what you shared without losing the conversation."
    ) %>

<div class="mx-auto max-w-2xl">
  <%= render PlatformCore::Ui::CardComponent.new do %>
    <%= render "form", post: @post, url: post_path(@post), method: :patch, composer: false %>
  <% end %>
</div>
