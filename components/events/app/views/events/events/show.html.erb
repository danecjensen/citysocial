<div class="mb-6">
  <%= link_to "← Back to all events", all_path, class: "font-mono text-xs text-ink-muted hover:text-brand-700" %>
</div>

<article class="mx-auto max-w-3xl">
  <div class="relative mb-6 aspect-[16/9] w-full overflow-hidden rounded-lg border border-line bg-sunken" <%= tag.attributes(data: { controller: "remote-image" }) if @event.image_url.present? %>>
    <% if @event.image_url.present? %>
      <%= image_tag @event.image_url, alt: @event.title, class: "h-full w-full object-cover",
            data: {
              remote_image_target: "image",
              action: "load->remote-image#verify error->remote-image#showPlaceholder"
            } %>
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-gradient-to-br from-brand-50 to-sunken text-center"
           data-remote-image-target="placeholder" hidden role="img" aria-label="Image unavailable for <%= @event.title %>">
        <span class="text-5xl" aria-hidden="true"><%= @event.category_emoji %></span>
        <span class="font-mono text-xs font-bold uppercase tracking-wide text-ink-muted">Image unavailable</span>
      </div>
    <% else %>
      <div class="flex h-full flex-col items-center justify-center gap-2 bg-gradient-to-br from-brand-50 to-sunken text-center"
           role="img" aria-label="No image available for <%= @event.title %>">
        <span class="text-5xl" aria-hidden="true"><%= @event.category_emoji %></span>
        <span class="font-mono text-xs font-bold uppercase tracking-wide text-ink-muted">Image unavailable</span>
      </div>
    <% end %>
  </div>

  <div class="mb-3 flex flex-wrap items-center gap-2">
    <%= render PlatformCore::Ui::BadgeComponent.new(variant: :brand) do %><%= @event.category_emoji %> <%= @event.category_label %><% end %>
    <%= render PlatformCore::Ui::BadgeComponent.new(variant: :neutral) do %><%= @event.price_display %><% end %>
    <% if @event.age_limit.present? %>
      <%= render PlatformCore::Ui::BadgeComponent.new(variant: :neutral) do %><%= @event.age_limit %><% end %>
    <% end %>
    <% if @event.ticket_urgency.present? %>
      <%= render PlatformCore::Ui::BadgeComponent.new(variant: :danger) do %>⚠ <%= @event.ticket_urgency %><% end %>
    <% end %>
  </div>

  <h1 class="font-display text-3xl font-black tracking-tight text-ink"><%= @event.title %></h1>

  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-sm text-ink-muted">
    <span>📅 <%= @event.when_display %></span>
    <% if @event.venue.present? %><span>📍 <%= @event.venue %></span><% end %>
  </div>

  <% if @event.why.present? %>
    <div class="mt-6 rounded-lg border border-brand-200 bg-brand-50 p-4">
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-brand-800">Why it made the list</p>
      <p class="mt-2 leading-relaxed text-ink"><%= @event.why %></p>
    </div>
  <% end %>

  <% if @event.description.present? %>
    <div class="mt-6 border-t border-line pt-6">
      <p class="whitespace-pre-line leading-relaxed text-ink"><%= @event.description %></p>
    </div>
  <% end %>

  <% if @event.url.present? %>
    <div class="mt-8">
      <%= render PlatformCore::Ui::ButtonComponent.new(
        variant: :primary,
        size: :lg,
        href: @event.url,
        target: "_blank",
        rel: "noopener noreferrer"
      ) do %>🎟️ Tickets &amp; details<% end %>
    </div>
  <% end %>

  <div class="mt-6 border-t border-line pt-6">
    <h2 class="mb-3 font-mono text-xs uppercase tracking-wide text-ink-muted">Add to calendar</h2>
    <div class="flex flex-wrap gap-2">
      <%= render PlatformCore::Ui::ButtonComponent.new(
        variant: :secondary,
        href: @event.google_calendar_url,
        target: "_blank",
        rel: "noopener noreferrer"
      ) do %>📅 Google Calendar<% end %>
      <%= render PlatformCore::Ui::ButtonComponent.new(
        variant: :secondary,
        href: event_calendar_path(@event)
      ) do %>⬇️ Download .ics<% end %>
    </div>
  </div>

  <div class="mt-6">
    <%= render PlatformCore::Ui::ShareComponent.new(
      title: @event.title,
      url: event_url(@event)
    ) %>
  </div>
</article>
