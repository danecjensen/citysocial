<%# Local: event, optional rank %>
<%= link_to event_path(event), class: "group block overflow-hidden rounded-lg border border-line bg-surface shadow-card transition-shadow hover:shadow-pop" do %>
  <%# The placeholder is always rendered underneath; a remote image that fails to
      load removes itself and reveals it. No JS controller, no hidden toggling. %>
  <div class="relative aspect-[16/9] w-full overflow-hidden bg-sunken">
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-gradient-to-br from-brand-50 to-sunken text-center"
         role="img" aria-label="No image available for <%= event.title %>">
      <span class="text-4xl" aria-hidden="true"><%= event.category_emoji %></span>
      <span class="font-mono text-xs font-bold uppercase tracking-wide text-ink-muted">Image unavailable</span>
    </div>
    <% if event.image_url.present? %>
      <%= image_tag event.image_url, loading: "lazy", alt: event.title,
            class: "absolute inset-0 h-full w-full object-cover transition-transform group-hover:scale-105",
            onerror: "this.remove()" %>
    <% end %>
    <% if defined?(rank) && rank %>
      <span class="absolute left-2 top-2 inline-flex h-7 w-7 items-center justify-center rounded-full bg-brand-600 font-display text-sm font-black text-white shadow-pop">
        <%= rank %>
      </span>
    <% end %>
  </div>
  <div class="p-4">
    <div class="flex items-center gap-2">
      <%= render PlatformCore::Ui::BadgeComponent.new(variant: :brand) do %><%= event.category_emoji %> <%= event.category_label %><% end %>
    </div>
    <p class="mt-2 line-clamp-2 font-display text-base font-bold text-ink group-hover:text-brand-700"><%= event.title %></p>
    <% if event.why.present? %>
      <p class="mt-2 line-clamp-2 text-sm leading-snug text-ink-muted"><%= event.why %></p>
    <% end %>
    <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-ink-faint">
      <span><%= event.when_display %></span>
      <% if event.venue.present? %><span>· <%= event.venue %></span><% end %>
      <span>· <%= event.price_display %></span>
    </div>
  </div>
<% end %>
