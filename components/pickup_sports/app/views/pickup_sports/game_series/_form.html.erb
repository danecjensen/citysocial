<%= form_with model: game_series, url: series_index_path do |f| %>
  <% if game_series.errors.any? %>
    <div class="mb-4">
      <%= render PlatformCore::Ui::FlashComponent.new(type: :error, message: game_series.errors.full_messages.to_sentence) %>
    </div>
  <% end %>

  <%= render PlatformCore::Ui::FormFieldComponent.new(
        form: f,
        attribute: :title,
        label: "Series title",
        placeholder: "Wednesday evening soccer"
      ) %>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= render PlatformCore::Ui::FormFieldComponent.new(
          form: f,
          attribute: :sport,
          type: :select,
          label: "Sport",
          collection: PickupSports::Game::SPORTS.map { |sport| [sport.titleize, sport] },
          include_blank: "Choose a sport"
        ) %>
    <%= render PlatformCore::Ui::FormFieldComponent.new(
          form: f,
          attribute: :skill_level,
          type: :select,
          label: "Skill and welcome level",
          collection: PickupSports::Game::SKILL_LEVELS.map { |level| [level.humanize, level] },
          include_blank: "Choose a level"
        ) %>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <%= render PlatformCore::Ui::FormFieldComponent.new(
          form: f,
          attribute: :starts_at,
          label: "First game",
          hint: "Later games keep this local day and time.",
          placeholder: "YYYY-MM-DD HH:MM",
          value: game_series.starts_at&.strftime("%Y-%m-%d %H:%M")
        ) %>
    <%= render PlatformCore::Ui::FormFieldComponent.new(
          form: f,
          attribute: :occurrences_count,
          type: :number_field,
          label: "Number of weeks",
          hint: "Schedule 2–8 weekly games.",
          min: PickupSports::GameSeries::MIN_OCCURRENCES,
          max: PickupSports::GameSeries::MAX_OCCURRENCES
        ) %>
    <%= render PlatformCore::Ui::FormFieldComponent.new(
          form: f,
          attribute: :capacity,
          type: :number_field,
          label: "Players per game",
          hint: "Includes you as host.",
          min: 2,
          max: 100
        ) %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= render PlatformCore::Ui::FormFieldComponent.new(
          form: f,
          attribute: :neighborhood,
          label: "Neighborhood",
          placeholder: "East Austin"
        ) %>
    <%= render PlatformCore::Ui::FormFieldComponent.new(
          form: f,
          attribute: :venue,
          label: "Venue or court",
          placeholder: "Pan Am Park"
        ) %>
  </div>

  <%= render PlatformCore::Ui::FormFieldComponent.new(
        form: f,
        attribute: :details,
        type: :text_area,
        label: "Welcome notes",
        hint: "These expectations appear on every game in the series.",
        rows: 5
      ) %>

  <div class="flex flex-wrap gap-2">
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, type: :submit) do %>Schedule series<% end %>
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :ghost, href: games_path) do %>Cancel<% end %>
  </div>
<% end %>
