<%= render PlatformCore::Ui::PageHeaderComponent.new(
      title: "Neighbor Help",
      subtitle: "One practical, unpaid favor. One accountable helper. A visible finish."
    ) do |header| %>
  <% if logged_in? %>
    <% header.with_actions do %>
      <% if admin? %>
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, href: admin_requests_path) do %>Review reports<% end %>
      <% end %>
      <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: new_request_path) do %>Ask for help<% end %>
    <% end %>
  <% end %>
<% end %>

<%= form_with url: requests_path, method: :get, class: "mb-6 grid items-end gap-3 md:grid-cols-4" do |f| %>
  <%= render PlatformCore::Ui::FormFieldComponent.new(
        form: f,
        attribute: :category,
        type: :select,
        label: "Category",
        collection: NeighborHelp::Request::CATEGORIES.map { |category| [category.humanize, category] },
        include_blank: "All safe favors",
        selected: @category
      ) %>
  <%= render PlatformCore::Ui::FormFieldComponent.new(
        form: f,
        attribute: :neighborhood,
        label: "Neighborhood",
        value: @neighborhood,
        placeholder: "North Loop"
      ) %>
  <%= render PlatformCore::Ui::FormFieldComponent.new(
        form: f,
        attribute: :on,
        label: "Date",
        value: params[:on],
        placeholder: "YYYY-MM-DD"
      ) %>
  <div class="mb-4 flex gap-2">
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, type: :submit) do %>Find favors<% end %>
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :ghost, href: requests_path) do %>Reset<% end %>
  </div>
<% end %>

<% if @requests.any? %>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @requests.each do |request| %>
      <%= render PlatformCore::Ui::CardComponent.new do %>
        <div class="flex flex-wrap gap-2">
          <%= render PlatformCore::Ui::BadgeComponent.new(variant: :agave) do %><%= request.category.humanize %><% end %>
          <% if request.claimed? %>
            <%= render PlatformCore::Ui::BadgeComponent.new(variant: :neutral) do %>Claimed<% end %>
          <% else %>
            <%= render PlatformCore::Ui::BadgeComponent.new(variant: :success) do %>Open<% end %>
          <% end %>
        </div>
        <h2 class="mt-3 font-display text-xl font-bold text-ink">
          <%= link_to request.title, request_path(request), class: "hover:text-brand-700" %>
        </h2>
        <dl class="mt-3 space-y-1 text-sm text-ink-muted">
          <div><dt class="inline font-bold text-ink">Where:</dt> <dd class="inline"><%= request.neighborhood %></dd></div>
          <div><dt class="inline font-bold text-ink">Window:</dt> <dd class="inline"><%= request.starts_at.to_fs(:short) %>–<%= request.ends_at.to_fs(:short) %></dd></div>
          <div><dt class="inline font-bold text-ink">Size:</dt> <dd class="inline">About <%= request.estimated_minutes %> minutes</dd></div>
        </dl>
        <% requester = @residents[request.requester_id] %>
        <p class="mt-4 font-mono text-xs text-ink-faint">
          Requested by
          <% if requester %>
            <%= link_to "@#{requester.handle}", "/people/#{requester.handle}", class: "text-brand-700 hover:underline" %>
          <% else %>
            a former resident
          <% end %>
        </p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render PlatformCore::Ui::EmptyStateComponent.new(
        title: "No matching favors right now",
        body: "Try a broader neighborhood or date. Current requests stay visible through claim or until their time window ends."
      ) do |empty| %>
    <% if logged_in? %>
      <% empty.with_action do %>
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: new_request_path) do %>Ask for help<% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
