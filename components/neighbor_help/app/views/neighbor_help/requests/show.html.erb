<div class="mb-3">
  <%= link_to "← Neighbor Help", requests_path, class: "font-mono text-xs text-ink-muted hover:text-brand-700" %>
</div>

<%= render PlatformCore::Ui::PageHeaderComponent.new(
      title: @request.title,
      subtitle: "#{@request.neighborhood} · #{@request.starts_at.to_fs(:long)}–#{@request.ends_at.to_fs(:short)}"
    ) do |header| %>
  <% if logged_in? && current_user.id == @request.requester_id && @request.active? %>
    <% header.with_actions do %>
      <% if @request.claimed? %>
        <%= render PlatformCore::Ui::ButtonComponent.new(
              variant: :primary,
              href: complete_request_path(@request),
              method: :patch,
              confirm: "Mark this favor complete?"
            ) do %>Mark complete<% end %>
      <% end %>
      <%= render PlatformCore::Ui::ButtonComponent.new(
            variant: :danger,
            href: cancel_request_path(@request),
            method: :patch,
            confirm: "Cancel this favor?"
          ) do %>Cancel favor<% end %>
    <% end %>
  <% end %>
<% end %>

<% if @request.hidden? %>
  <div class="mb-6">
    <%= render PlatformCore::Ui::FlashComponent.new(type: :error, message: "This favor is hidden from public discovery while moderation is resolved.") %>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="space-y-6">
    <%= render PlatformCore::Ui::CardComponent.new do %>
      <div class="flex flex-wrap gap-2">
        <%= render PlatformCore::Ui::BadgeComponent.new(variant: :agave) do %><%= @request.category.humanize %><% end %>
        <% status_variant = @request.open? ? :success : (@request.completed? ? :brand : :neutral) %>
        <%= render PlatformCore::Ui::BadgeComponent.new(variant: status_variant) do %><%= @request.display_status.humanize %><% end %>
      </div>

      <dl class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-ink-faint">Neighborhood</dt>
          <dd class="mt-1 font-bold text-ink"><%= @request.neighborhood %></dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-ink-faint">Estimated size</dt>
          <dd class="mt-1 font-bold text-ink">About <%= @request.estimated_minutes %> minutes</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-ink-faint">Available from</dt>
          <dd class="mt-1 font-bold text-ink"><%= @request.starts_at.to_fs(:long) %></dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-ink-faint">Needed by</dt>
          <dd class="mt-1 font-bold text-ink"><%= @request.ends_at.to_fs(:long) %></dd>
        </div>
      </dl>

      <div class="mt-5 whitespace-pre-wrap text-[15px] leading-relaxed text-ink"><%= @request.details %></div>

      <% if @request.logistics_notes.present? %>
        <div class="mt-5 border-t border-line pt-4">
          <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">Public-place logistics</p>
          <p class="mt-1 whitespace-pre-wrap text-sm text-ink-muted"><%= @request.logistics_notes %></p>
        </div>
      <% end %>
    <% end %>

    <% if logged_in? && @request.open? && !@request.expired? && current_user.id != @request.requester_id %>
      <%= render PlatformCore::Ui::CardComponent.new do %>
        <p class="font-bold text-ink">You can take responsibility for this one favor.</p>
        <p class="mt-1 text-sm text-ink-muted">Claim only if the time window works. Private coordination can happen after the requester sees your commitment.</p>
        <div class="mt-4">
          <%= render PlatformCore::Ui::ButtonComponent.new(
                variant: :primary,
                href: request_claim_path(@request),
                method: :post
              ) do %>Claim this favor<% end %>
        </div>
      <% end %>
    <% elsif logged_in? && @request.claimed? && current_user.id == @request.helper_id %>
      <%= render PlatformCore::Ui::CardComponent.new do %>
        <p class="font-bold text-ink">You claimed this favor.</p>
        <p class="mt-1 text-sm text-ink-muted">If plans change, release it promptly so another neighbor can step in.</p>
        <% unless @request.expired? %>
          <div class="mt-4">
            <%= render PlatformCore::Ui::ButtonComponent.new(
                  variant: :secondary,
                  href: request_claim_path(@request),
                  method: :delete,
                  confirm: "Release this favor?"
                ) do %>Release favor<% end %>
          </div>
        <% end %>
      <% end %>
    <% elsif @request.expired? %>
      <%= render PlatformCore::Ui::EmptyStateComponent.new(
            title: "This favor's time window ended",
            body: "It stays readable for clarity, but it can no longer be claimed or released."
          ) %>
    <% elsif @request.completed? %>
      <%= render PlatformCore::Ui::EmptyStateComponent.new(
            title: "Favor completed",
            body: "The requester closed the loop and recorded the finished commitment."
          ) %>
    <% elsif @request.canceled? %>
      <%= render PlatformCore::Ui::EmptyStateComponent.new(
            title: "Favor canceled",
            body: "The request is closed and can no longer be claimed."
          ) %>
    <% end %>

    <% if logged_in? && current_user.id != @request.requester_id && !@request.hidden? %>
      <%= render PlatformCore::Ui::CardComponent.new do |card| %>
        <% card.with_header do %><span class="font-display text-lg font-bold text-ink">Report an unsafe request</span><% end %>
        <p class="mb-4 text-sm text-ink-muted">Report money, contact details, exact addresses, care work, rides, hazardous work, or spam. Reports go to CitySocial admins.</p>
        <%= form_with model: @report, url: request_reports_path(@request) do |f| %>
          <%= render PlatformCore::Ui::FormFieldComponent.new(
                form: f,
                attribute: :reason,
                type: :select,
                label: "Reason",
                collection: NeighborHelp::Report::REASONS.map { |reason| [reason.humanize, reason] },
                include_blank: "Choose a reason"
              ) %>
          <%= render PlatformCore::Ui::FormFieldComponent.new(
                form: f,
                attribute: :details,
                type: :text_area,
                label: "Optional review note",
                rows: 3
              ) %>
          <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, type: :submit) do %>Send report<% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= render PlatformCore::Ui::CardComponent.new do |card| %>
    <% card.with_header do %><span class="font-display text-lg font-bold text-ink">Commitment</span><% end %>
    <% requester = @residents[@request.requester_id] %>
    <% helper = @residents[@request.helper_id] %>
    <div class="space-y-5">
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">Requested by</p>
        <% if requester %>
          <%= link_to requester.display_name_or_handle, "/people/#{requester.handle}", class: "mt-1 block font-bold text-brand-700 hover:underline" %>
          <span class="font-mono text-xs text-ink-faint">@<%= requester.handle %></span>
        <% else %>
          <p class="mt-1 text-sm text-ink-muted">Former resident</p>
        <% end %>
      </div>
      <div class="border-t border-line pt-4">
        <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">Helper</p>
        <% if helper %>
          <%= link_to helper.display_name_or_handle, "/people/#{helper.handle}", class: "mt-1 block font-bold text-brand-700 hover:underline" %>
          <span class="font-mono text-xs text-ink-faint">@<%= helper.handle %></span>
        <% elsif @request.open? && !@request.expired? %>
          <p class="mt-1 text-sm text-ink-muted">Waiting for one neighbor to claim it.</p>
        <% else %>
          <p class="mt-1 text-sm text-ink-muted">No current helper.</p>
        <% end %>
      </div>
      <div class="border-t border-line pt-4">
        <%= render PlatformCore::Ui::BadgeComponent.new(variant: :success) do %>No money<% end %>
        <p class="mt-2 text-xs text-ink-faint">The requester confirmed this is an unpaid favor with no reimbursement.</p>
      </div>
    </div>
  <% end %>
</div>
