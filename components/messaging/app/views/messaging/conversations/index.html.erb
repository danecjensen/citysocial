<%= render PlatformCore::Ui::PageHeaderComponent.new(
      title: @archived ? "Archived messages" : "Messages",
      subtitle: @archived ? "Conversations you moved out of your inbox." : (@unread_count.positive? ? "#{@unread_count} unread" : "Private conversations with people in your city.")
    ) do |header| %>
  <% header.with_actions do %>
    <%= render PlatformCore::Ui::ButtonComponent.new(
          variant: @archived ? :secondary : :primary,
          href: conversations_path
        ) do %>
      Inbox
    <% end %>
    <%= render PlatformCore::Ui::ButtonComponent.new(
          variant: @archived ? :primary : :secondary,
          href: conversations_path(view: "archived")
        ) do %>
      Archived
    <% end %>
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: new_conversation_path) do %>
      New conversation
    <% end %>
  <% end %>
<% end %>

<div class="mx-auto mb-6 max-w-3xl">
  <%= render PlatformCore::Ui::CardComponent.new do %>
    <%= form_with url: conversations_path, method: :get do |f| %>
      <% if @archived %>
        <%= f.hidden_field :view, value: "archived" %>
      <% end %>
      <%= render PlatformCore::Ui::FormFieldComponent.new(
            form: f,
            attribute: :q,
            label: "Search conversations",
            value: @query,
            placeholder: "Handle or display name"
          ) %>
      <div class="flex flex-wrap items-center gap-2">
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, type: :submit) do %>
          Search
        <% end %>
        <% if @query.present? %>
          <%= render PlatformCore::Ui::ButtonComponent.new(
                variant: :ghost,
                href: conversations_path(view: (@archived ? "archived" : nil))
              ) do %>
            Clear
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<% if @conversations.any? %>
  <div class="mx-auto max-w-3xl space-y-3">
    <% @conversations.each do |conversation| %>
      <% other_participant = conversation.other_participant(current_user.id) %>
      <% last_message = conversation.messages.last %>
      <% unread_count = conversation.unread_count_for(current_user.id) %>
      <%= render PlatformCore::Ui::CardComponent.new do %>
        <div class="flex flex-wrap items-center gap-4">
          <% if other_participant %>
            <%= render PlatformCore::Ui::AvatarComponent.new(user: other_participant, size: :md, alt: "") %>
          <% end %>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-display font-bold text-ink">
                <%= other_participant&.display_name_or_handle || "Resident" %>
              </p>
              <% if unread_count.positive? %>
                <%= render PlatformCore::Ui::BadgeComponent.new(variant: :brand) do %>
                  <%= pluralize(unread_count, "unread") %>
                <% end %>
              <% end %>
            </div>
            <% if last_message %>
              <p class="mt-1 truncate text-sm text-ink-muted"><%= last_message.body %></p>
              <p class="mt-1 font-mono text-xs text-ink-faint">
                <%= time_ago_in_words(last_message.created_at) %> ago
              </p>
            <% end %>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <%= render PlatformCore::Ui::ButtonComponent.new(
                  variant: unread_count.positive? ? :primary : :secondary,
                  size: :sm,
                  href: conversation_path(conversation)
                ) do %>
              Open
            <% end %>
            <% if @archived %>
              <%= render PlatformCore::Ui::ButtonComponent.new(
                    variant: :ghost,
                    size: :sm,
                    href: restore_conversation_path(conversation),
                    method: :patch
                  ) do %>
                Restore
              <% end %>
            <% else %>
              <%= render PlatformCore::Ui::ButtonComponent.new(
                    variant: :ghost,
                    size: :sm,
                    href: archive_conversation_path(conversation),
                    method: :patch
                  ) do %>
                Archive
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render PlatformCore::Ui::EmptyStateComponent.new(
        title: @query.present? ? "No conversations found" : (@archived ? "No archived conversations" : "No conversations yet"),
        body: @query.present? ? "Try another resident handle or display name." : (@archived ? "Archive a conversation to move it out of your inbox without deleting its history." : "Start with a resident's handle, or use the Message resident action on their public profile.")
      ) do |empty| %>
    <% unless @archived || @query.present? %>
      <% empty.with_action do %>
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: new_conversation_path) do %>
          Start a conversation
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
