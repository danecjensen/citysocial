<%= render PlatformCore::Ui::PageHeaderComponent.new(title: "Communities", subtitle: "Find your people. Join a community to post and discuss.") do |header| %>
  <% if logged_in? %>
    <% header.with_actions do %>
      <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: new_community_path) do %>
        New community
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @communities.any? %>
  <div class="grid gap-4 sm:grid-cols-2">
    <% @communities.each do |community| %>
      <%= render PlatformCore::Ui::CardComponent.new do %>
        <div class="flex items-start justify-between gap-3">
          <div>
            <%= link_to "c/#{community.name}", community_path(community), class: "font-display text-lg font-bold text-ink hover:text-brand-700" %>
            <% if community.category.present? %>
              <div class="mt-1"><%= render PlatformCore::Ui::BadgeComponent.new(variant: :agave) do %><%= community.category.humanize %><% end %></div>
            <% end %>
          </div>
          <span class="whitespace-nowrap font-mono text-xs text-ink-faint"><%= pluralize(community.members_count, "member") %></span>
        </div>
        <% if community.description.present? %>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted"><%= truncate(community.description, length: 140) %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render PlatformCore::Ui::EmptyStateComponent.new(title: "No communities yet", body: "Be the first to start one for your city.") do |empty| %>
    <% if logged_in? %>
      <% empty.with_action do %>
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: new_community_path) do %>Start a community<% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
