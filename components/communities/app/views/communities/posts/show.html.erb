<div class="mb-2">
  <%= link_to "← c/#{@community.name}", community_path(@community), class: "font-mono text-xs text-ink-muted hover:text-brand-700" %>
</div>

<% post_author = @post.author %>
<%= render PlatformCore::Ui::CardComponent.new do %>
  <div class="flex gap-3">
    <%= render "communities/posts/vote", score: @post.score,
               up_url: upvote_community_post_path(@community, @post),
               down_url: downvote_community_post_path(@community, @post),
               my_vote: @post.vote_value_for(current_user&.id) %>
    <div class="min-w-0 flex-1">
      <h1 class="font-display text-2xl font-black text-ink"><%= @post.title %></h1>
      <div class="mt-1 flex items-center gap-2 font-mono text-xs text-ink-faint">
        <% if post_author %>
          <%= link_to "@#{post_author.handle}", "/people/#{post_author.handle}", class: "text-brand-700 hover:underline" %>
        <% else %>
          <span>former resident</span>
        <% end %>
        <span><%= time_ago_in_words(@post.created_at) %> ago</span>
      </div>
      <% if @post.url.present? %>
        <p class="mt-3"><%= link_to @post.url, @post.url, class: "text-sm font-semibold text-agave-700 underline break-all", target: "_blank", rel: "noopener" %></p>
      <% end %>
      <% if @post.body.present? %>
        <p class="mt-3 whitespace-pre-wrap text-[15px] leading-relaxed text-ink"><%= @post.body %></p>
      <% end %>
    </div>
  </div>
<% end %>

<section class="mt-8">
  <h2 class="mb-4 font-display text-lg font-bold text-ink"><%= pluralize(@post.comments_count, "comment") %></h2>

  <% if logged_in? %>
    <% unless @post.locked %>
      <div class="mb-6">
        <%= render PlatformCore::Ui::CardComponent.new do %>
          <%= form_with url: community_post_comments_path(@community, @post), method: :post, scope: :comment do |f| %>
            <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :body, type: :text_area, label: "Add a comment", rows: 3) %>
            <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, type: :submit) do %>Comment<% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @comments.any? %>
    <div class="space-y-3">
      <% @comments.each do |comment| %>
        <% comment_author = comment.author %>
        <div id="comment-<%= comment.id %>" class="flex gap-3 rounded-lg border border-line bg-surface p-4">
          <%= render "communities/posts/vote", score: comment.score,
                     up_url: upvote_community_post_comment_path(@community, @post, comment),
                     down_url: downvote_community_post_comment_path(@community, @post, comment),
                     my_vote: comment.vote_value_for(current_user&.id) %>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 font-mono text-xs text-ink-faint">
              <% if comment_author %>
                <%= link_to "@#{comment_author.handle}", "/people/#{comment_author.handle}", class: "text-brand-700 hover:underline" %>
              <% else %>
                <span>former resident</span>
              <% end %>
              <span><%= time_ago_in_words(comment.created_at) %> ago</span>
            </div>
            <p class="mt-1 whitespace-pre-wrap text-sm leading-relaxed text-ink"><%= comment.body %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-ink-muted">No comments yet.</p>
  <% end %>
</section>
