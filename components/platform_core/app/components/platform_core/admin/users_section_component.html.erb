<%= render PlatformCore::Ui::TableComponent.new(columns: ["Handle", "Email", "Role", "Joined", { label: "Actions", numeric: true }]) do |table| %>
  <% users.each do |user| %>
    <% table.with_row do |row| %>
      <% row.with_cell do %>
        <span class="font-mono font-semibold text-brand-700">@<%= user.handle %></span>
      <% end %>
      <% row.with_cell { user.email } %>
      <% row.with_cell do %>
        <% if user.admin? %>
          <%= render PlatformCore::Ui::BadgeComponent.new(variant: :danger) do %>Admin<% end %>
        <% else %>
          <%= render PlatformCore::Ui::BadgeComponent.new(variant: :neutral) do %>Member<% end %>
        <% end %>
      <% end %>
      <% row.with_cell do %>
        <span class="font-mono text-xs text-ink-muted"><%= user.created_at.to_date %></span>
      <% end %>
      <% row.with_cell do %>
        <div class="flex justify-end gap-2">
          <% if user.admin? %>
            <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, size: :sm, href: "/admin/users/#{user.id}?admin=false", method: :patch) do %>
              Revoke admin
            <% end %>
          <% else %>
            <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, size: :sm, href: "/admin/users/#{user.id}?admin=true", method: :patch) do %>
              Make admin
            <% end %>
          <% end %>
          <% unless user == current_user %>
            <%= render PlatformCore::Ui::ButtonComponent.new(variant: :danger, size: :sm, href: "/admin/users/#{user.id}", method: :delete, confirm: "Delete @#{user.handle}?") do %>
              Delete
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
