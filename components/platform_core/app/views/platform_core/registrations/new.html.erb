<div class="mx-auto max-w-sm">
  <h1 class="mb-2 text-center font-display text-3xl font-black">Sign up</h1>
  <p class="mb-6 text-center text-sm text-ink-muted">Join your city.</p>

  <%= render PlatformCore::Ui::CardComponent.new do %>
    <%= form_with model: @user, url: "/signup", method: :post do |f| %>
      <% if @user.errors.any? %>
        <div class="mb-4">
          <%= render PlatformCore::Ui::FlashComponent.new(type: :error, message: "Please fix the issues below.") %>
        </div>
      <% end %>

      <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :handle, autofocus: true,
                                                          hint: "Your public @name.") %>
      <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :email, type: :email_field,
                                                          autocomplete: "email") %>
      <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :password, type: :password_field,
                                                          autocomplete: "new-password") %>
      <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :password_confirmation, type: :password_field,
                                                          label: "Confirm password", autocomplete: "new-password") %>
      <div class="mt-6 grid">
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, size: :lg) do %>
          Create account
        <% end %>
      </div>
    <% end %>
  <% end %>

  <p class="mt-4 text-center text-sm text-ink-muted">
    Already have an account? <%= link_to "Log in", "/login", class: "font-bold text-brand-700 hover:underline" %>
  </p>
</div>
