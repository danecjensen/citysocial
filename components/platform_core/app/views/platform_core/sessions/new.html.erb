<div class="mx-auto max-w-sm">
  <h1 class="mb-6 text-center font-display text-3xl font-black">Log in</h1>

  <%= render PlatformCore::Ui::CardComponent.new do %>
    <%= form_with url: "/login", method: :post do |f| %>
      <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :email, type: :email_field,
                                                          autocomplete: "email", autofocus: true) %>
      <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :password, type: :password_field,
                                                          autocomplete: "current-password") %>
      <div class="mt-6 grid">
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, size: :lg) do %>
          Log in
        <% end %>
      </div>
    <% end %>
  <% end %>

  <p class="mt-4 text-center text-sm text-ink-muted">
    No account? <%= link_to "Sign up", "/signup", class: "font-bold text-brand-700 hover:underline" %>
  </p>
</div>
