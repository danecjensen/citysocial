<%= render PlatformCore::Ui::PageHeaderComponent.new(title: "Which is better?", subtitle: "Austin restaurants, head to head. Pick the one you'd rather eat at.") do |header| %>
  <% header.with_actions do %>
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, size: :sm, href: "/restaurants/leaderboard") do %>
      See the leaderboard
    <% end %>
  <% end %>
<% end %>

<% if @pair %>
  <% left, right = @pair %>
  <div class="relative mx-auto grid max-w-3xl gap-4 sm:grid-cols-2">
    <span class="absolute left-1/2 top-1/2 z-10 hidden -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-ink bg-paper px-3 py-1 font-display text-sm font-black sm:block">vs</span>
    <% [[left, right], [right, left]].each do |winner, loser| %>
      <%= render PlatformCore::Ui::CardComponent.new do %>
        <div class="flex h-full flex-col items-center gap-3 py-4 text-center">
          <div class="aspect-[4/3] w-full overflow-hidden rounded-lg bg-sunken">
            <% if winner.hero_photo %>
              <%= image_tag main_app.rails_blob_path(winner.hero_photo, only_path: true), class: "h-full w-full object-cover", alt: winner.name, loading: "lazy" %>
            <% else %>
              <div class="flex h-full items-center justify-center text-ink-faint">
                <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              </div>
            <% end %>
          </div>
          <h2 class="font-display text-2xl font-black"><%= winner.name %></h2>
          <div class="flex gap-2">
            <%= render PlatformCore::Ui::BadgeComponent.new(variant: :brand) do %><%= winner.cuisine %><% end %>
            <%= render PlatformCore::Ui::BadgeComponent.new(variant: :agave) do %><%= winner.area %><% end %>
          </div>
          <div class="mt-2">
            <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, size: :lg, href: "/restaurants/matchups",
                                                             method: :post, params: { winner_id: winner.id, loser_id: loser.id }) do %>
              Pick <%= winner.name %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render PlatformCore::Ui::EmptyStateComponent.new(
        title: "Not enough restaurants to compare yet",
        body: "Ask an admin to add a few spots, then come back and settle the score."
      ) %>
<% end %>
