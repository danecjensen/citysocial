<%= render PlatformCore::Ui::PageHeaderComponent.new(title: "Austin Restaurant Leaderboard", subtitle: "Ranked by head-to-head Elo.") do |header| %>
  <% header.with_actions do %>
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, size: :sm, href: "/restaurants") do %>
      Back to matchups
    <% end %>
  <% end %>
<% end %>

<% if @cuisines.any? %>
  <%= form_with url: "/restaurants/leaderboard", method: :get, class: "mb-6 flex items-end gap-3" do |f| %>
    <div class="w-full max-w-xs">
      <%= render PlatformCore::Ui::FormFieldComponent.new(
            form: f, attribute: :cuisine, type: :select, label: "Cuisine",
            collection: @cuisines, include_blank: "All cuisines", selected: @cuisine) %>
    </div>
    <div class="mb-4">
      <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, size: :md) do %>Filter<% end %>
    </div>
  <% end %>
<% end %>

<% if @restaurants.any? %>
  <%= render PlatformCore::Ui::TableComponent.new(columns: ["#", "Restaurant", "Cuisine", "Area", { label: "Elo", numeric: true }, { label: "Matchups", numeric: true }]) do |table| %>
    <% @restaurants.each_with_index do |restaurant, i| %>
      <% table.with_row do |row| %>
        <% row.with_cell do %>
          <span class="font-mono text-ink-faint"><%= i + 1 %></span>
        <% end %>
        <% row.with_cell do %>
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 flex-none overflow-hidden rounded-md bg-sunken">
              <% if restaurant.hero_photo %>
                <%= image_tag main_app.rails_blob_path(restaurant.hero_photo, only_path: true), class: "h-full w-full object-cover", alt: restaurant.name, loading: "lazy" %>
              <% end %>
            </div>
            <span class="font-bold"><%= restaurant.name %></span>
          </div>
        <% end %>
        <% row.with_cell do %>
          <%= render PlatformCore::Ui::BadgeComponent.new(variant: :brand) do %><%= restaurant.cuisine %><% end %>
        <% end %>
        <% row.with_cell do %>
          <%= render PlatformCore::Ui::BadgeComponent.new(variant: :agave) do %><%= restaurant.area %><% end %>
        <% end %>
        <% row.with_cell(numeric: true) do %>
          <span class="font-semibold"><%= restaurant.elo %></span>
        <% end %>
        <% row.with_cell(numeric: true) { restaurant.matches_count.to_s } %>
      <% end %>
    <% end %>
  <% end %>

  <section class="mt-10">
    <h2 class="mb-4 font-display text-xl font-black text-ink">Recent picks</h2>
    <% if @recent_picks.any? %>
      <div class="space-y-3">
        <% @recent_picks.each do |pick| %>
          <%= render PlatformCore::Ui::CardComponent.new do %>
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <span class="font-bold text-ink"><%= pick[:winner].name %></span>
              <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">beat</span>
              <span class="text-ink-muted"><%= pick[:loser].name %></span>
              <time datetime="<%= pick[:decided_at].iso8601 %>" title="<%= pick[:decided_at].strftime('%b %-d, %Y at %-l:%M %p') %>" class="ml-auto font-mono text-xs text-ink-faint">
                <%= time_ago_in_words(pick[:decided_at]) %> ago
              </time>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= render PlatformCore::Ui::EmptyStateComponent.new(
            title: "No picks yet",
            body: "Head to the matchups and settle a score — recent decisions show up here.") %>
    <% end %>
  </section>
<% else %>
  <%= render PlatformCore::Ui::EmptyStateComponent.new(
        title: "No restaurants on the board yet",
        body: "Once an admin adds a few spots and people start voting, the rankings show up here.") do |empty| %>
    <% empty.with_action do %>
      <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: "/restaurants") do %>
        Go rank some restaurants
      <% end %>
    <% end %>
  <% end %>
<% end %>
