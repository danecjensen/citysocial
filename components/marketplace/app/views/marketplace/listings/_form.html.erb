<%# Local: listing, url, method %>
<%= form_with model: listing, url: url, method: method do |f| %>
  <% if listing.errors.any? %>
    <div class="mb-4">
      <%= render PlatformCore::Ui::FlashComponent.new(type: :error, message: listing.errors.full_messages.to_sentence) %>
    </div>
  <% end %>

  <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :title, label: "Title") %>

  <div class="mb-4 grid gap-4 sm:grid-cols-2">
    <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :category, type: :select, label: "Category", collection: Marketplace::Listing::CATEGORIES.map { |c| [c.titleize, c] }, include_blank: "Choose one") %>
    <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :condition, type: :select, label: "Condition", collection: Marketplace::Listing::CONDITIONS.map { |c| [c.titleize, c] }, include_blank: "Not applicable") %>
  </div>

  <div class="mb-4 grid gap-4 sm:grid-cols-2">
    <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :price, type: :number_field, label: "Price ($)", hint: "Leave blank for free.", step: "0.01", min: "0", value: listing.price) %>
    <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :location, label: "Location", hint: "e.g. East Austin") %>
  </div>

  <%= render PlatformCore::Ui::FormFieldComponent.new(form: f, attribute: :description, type: :text_area, label: "Description", rows: 6) %>

  <div class="mb-4">
    <%= f.label :photos, "Photos", class: "mb-1 block text-sm font-bold text-ink" %>
    <%= f.file_field :photos, multiple: true, accept: "image/*", class: "block w-full text-sm text-ink-muted file:mr-3 file:rounded-md file:border-0 file:bg-sunken file:px-3 file:py-2 file:text-sm file:font-bold file:text-ink hover:file:bg-line" %>
    <% if listing.photos.attached? %>
      <p class="mt-1 text-xs text-ink-faint"><%= pluralize(listing.photos.count, "photo") %> attached. Uploading new ones adds to them.</p>
    <% end %>
  </div>

  <div class="flex items-center gap-2">
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, type: :submit) do %>Save listing<% end %>
    <%= render PlatformCore::Ui::ButtonComponent.new(variant: :ghost, href: listings_path) do %>Cancel<% end %>
  </div>
<% end %>
