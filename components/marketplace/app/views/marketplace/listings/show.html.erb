<div class="mb-2">
  <%= link_to "← Marketplace", listings_path, class: "font-mono text-xs text-ink-muted hover:text-brand-700" %>
</div>

<div class="grid gap-8 lg:grid-cols-2">
  <div>
    <% if @listing.photos.attached? %>
      <div class="overflow-hidden rounded-lg border border-line bg-sunken">
        <%= image_tag @listing.photos.first, class: "w-full object-cover", alt: @listing.title %>
      </div>
      <% if @listing.photos.count > 1 %>
        <div class="mt-3 grid grid-cols-4 gap-2">
          <% @listing.photos.drop(1).each do |photo| %>
            <div class="overflow-hidden rounded-md border border-line bg-sunken">
              <%= image_tag photo, class: "aspect-square w-full object-cover", alt: @listing.title %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="flex aspect-[4/3] items-center justify-center rounded-lg border border-line bg-sunken text-ink-faint">
        <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </div>
    <% end %>
  </div>

  <div>
    <div class="flex items-center gap-2">
      <span class="font-display text-3xl font-black text-ink"><%= @listing.price_display %></span>
      <% if @listing.sold? %>
        <%= render PlatformCore::Ui::BadgeComponent.new(variant: :danger) do %>Sold<% end %>
      <% end %>
    </div>
    <h1 class="mt-1 font-display text-2xl font-bold text-ink"><%= @listing.title %></h1>

    <div class="mt-3 flex flex-wrap gap-2">
      <%= render PlatformCore::Ui::BadgeComponent.new(variant: :agave) do %><%= @listing.category_display %><% end %>
      <% if @listing.condition.present? %>
        <%= render PlatformCore::Ui::BadgeComponent.new(variant: :neutral) do %><%= @listing.condition.titleize %><% end %>
      <% end %>
    </div>

    <% author = @listing.author %>
    <dl class="mt-4 space-y-1 font-mono text-xs text-ink-muted">
      <% if @listing.location.present? %><div>Location · <%= @listing.location %></div><% end %>
      <div>
        Posted by
        <% if author %><%= link_to "@#{author.handle}", "/people/#{author.handle}", class: "text-brand-700 hover:underline" %><% else %>a former resident<% end %>
        · <%= time_ago_in_words(@listing.created_at) %> ago
      </div>
      <div><%= pluralize(@listing.views_count, "view") %></div>
    </dl>

    <% if @listing.description.present? %>
      <p class="mt-4 whitespace-pre-wrap text-[15px] leading-relaxed text-ink"><%= @listing.description %></p>
    <% end %>

    <% if logged_in? && author && @listing.author_id != current_user.id && PlatformCore::Modules.enabled?("messaging") %>
      <% message_path = "/messaging/conversations/new?recipient=#{ERB::Util.url_encode(author.handle)}&context_path=#{ERB::Util.url_encode("/marketplace/#{@listing.to_param}")}&context_label=#{ERB::Util.url_encode(truncate(@listing.title, length: 120))}" %>
      <div class="mt-6">
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: message_path) do %>
          Message seller
        <% end %>
      </div>
    <% end %>

    <% if logged_in? && @listing.author_id == current_user.id %>
      <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-4">
        <% unless @listing.sold? %>
          <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, href: mark_sold_listing_path(@listing), method: :post) do %>Mark sold<% end %>
        <% end %>
        <% if @listing.renewable? %>
          <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, href: renew_listing_path(@listing), method: :post) do %>Renew<% end %>
        <% end %>
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :secondary, href: edit_listing_path(@listing)) do %>Edit<% end %>
        <%= render PlatformCore::Ui::ButtonComponent.new(variant: :danger, href: listing_path(@listing), method: :delete, confirm: "Delete this listing?") do %>Delete<% end %>
      </div>
    <% end %>
  </div>
</div>
