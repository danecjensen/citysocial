<%# Local: listing %>
<%= link_to listing_path(listing), class: "group block overflow-hidden rounded-lg border border-line bg-surface shadow-card transition-shadow hover:shadow-pop" do %>
  <div class="aspect-[4/3] w-full overflow-hidden bg-sunken">
    <% if listing.photos.attached? %>
      <%= image_tag listing.photos.first, class: "h-full w-full object-cover transition-transform group-hover:scale-105", alt: listing.title %>
    <% else %>
      <div class="flex h-full items-center justify-center text-ink-faint">
        <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </div>
    <% end %>
  </div>
  <div class="p-4">
    <div class="flex items-start justify-between gap-2">
      <span class="font-display text-lg font-bold text-ink"><%= listing.price_display %></span>
      <% if listing.sold? %>
        <%= render PlatformCore::Ui::BadgeComponent.new(variant: :danger) do %>Sold<% end %>
      <% end %>
    </div>
    <p class="mt-1 line-clamp-1 text-sm font-semibold text-ink group-hover:text-brand-700"><%= listing.title %></p>
    <div class="mt-2 flex items-center gap-2 font-mono text-xs text-ink-faint">
      <span><%= listing.category_display %></span>
      <% if listing.location.present? %><span>· <%= listing.location %></span><% end %>
    </div>
  </div>
<% end %>
