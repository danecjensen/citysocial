<!DOCTYPE html>
<html>
  <head>
    <title>CitySocial — Your Local Community Marketplace</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Connect with your local community. Buy, sell, discuss, and discover what's happening near you.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <%# Apply the saved theme before first paint to avoid a flash of the wrong mode. %>
    <script>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark") document.documentElement.classList.add("dark");
          else if (t === "light") document.documentElement.classList.add("light");
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= render "layouts/posthog" %>
    <%= javascript_importmap_tags %>
  </head>
  <% posthog_user = current_user if respond_to?(:current_user) && PlatformCore::Analytics.enabled? %>
  <body class="flex min-h-screen flex-col"
        data-posthog-distinct-id="<%= posthog_user&.posthog_distinct_id %>"
        data-posthog-person-properties="<%= PlatformCore::Analytics.person_properties(posthog_user).to_json if posthog_user %>">
    <%= render PlatformCore::Ui::NavBarComponent.new do |nav| %>
      <% PlatformCore::Modules.primary_nav_modules.each do |mod| %>
        <% nav.with_link mod.label, mod.path, active: request.path.start_with?(mod.path) && !request.path.include?("/admin") %>
      <% end %>
      <% nav.with_link "About", "/about", active: request.path == "/about" %>
      <% if respond_to?(:admin?) && admin? %>
        <%# The whole admin area is one page; every section lives at /admin. %>
        <% nav.with_link "Admin", "/admin", active: request.path.start_with?("/admin") %>
        <% nav.with_link "Developer", "/developer", active: request.path.start_with?("/developer") %>
      <% end %>
      <% PlatformCore::Modules.secondary_nav_modules.each do |mod| %>
        <% nav.with_menu_link mod.label, mod.path, active: request.path.start_with?(mod.path) && !request.path.include?("/admin") %>
      <% end %>

      <% if respond_to?(:logged_in?) && logged_in? %>
        <% nav.with_session_area do %>
          <%# Notifications live on their own page, reached from this bell; the red
              bubble shows the unread count next to the profile avatar. %>
          <% if PlatformCore::Modules.enabled?("notifications") %>
            <% unread_notifications = Notifications::Inbox.unread_count_for(current_user.id) %>
            <%= link_to "/notifications/", "aria-label": "Notifications",
                        class: "relative rounded-full p-2 text-ink-muted transition-colors hover:bg-sunken hover:text-ink" do %>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
              <% if unread_notifications.positive? %>
                <span class="absolute -right-0.5 -top-0.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-danger px-1 text-xs font-bold leading-none text-white">
                  <%= unread_notifications > 99 ? "99+" : unread_notifications %>
                </span>
              <% end %>
            <% end %>
          <% end %>

          <%# The profile avatar is the account menu: click it for the profile link,
              log out, and anything else that used to sit loose in the top bar. %>
          <details class="relative"
                   data-controller="menu"
                   data-action="keydown.esc@window->menu#close click@window->menu#closeOnOutside">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full py-1 pl-1 pr-2 transition-colors hover:bg-sunken [&::-webkit-details-marker]:hidden"
                     aria-label="Account menu">
              <%= render PlatformCore::Ui::AvatarComponent.new(user: current_user, size: :sm, alt: "") %>
              <span class="hidden font-mono text-sm text-ink-muted sm:inline">@<%= current_user.handle %></span>
              <svg class="h-4 w-4 text-ink-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="absolute right-0 mt-2 w-56 rounded-2xl border border-line bg-surface p-2 shadow-card">
              <div class="border-b border-line px-3 pb-2 pt-1">
                <p class="truncate text-sm font-bold text-ink"><%= current_user.display_name_or_handle %></p>
                <p class="truncate font-mono text-xs text-ink-faint">@<%= current_user.handle %></p>
              </div>
              <%= link_to "View profile", "/people/#{current_user.handle}",
                          class: "mt-1 block rounded-xl px-3 py-2 text-sm font-semibold text-ink-muted transition-colors hover:bg-sunken hover:text-ink" %>
              <%= button_to "Log out", "/logout", method: :delete,
                            class: "block w-full rounded-xl px-3 py-2 text-left text-sm font-semibold text-ink-muted transition-colors hover:bg-sunken hover:text-ink" %>
            </div>
          </details>
        <% end %>
      <% else %>
        <% nav.with_session_area do %>
          <%= render PlatformCore::Ui::ButtonComponent.new(variant: :ghost, size: :sm, href: "/login") do %>
            Log in
          <% end %>
          <%= render PlatformCore::Ui::ButtonComponent.new(variant: :primary, size: :sm, href: "/signup") do %>
            Sign up
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
      <% flash.each do |type, message| %>
        <div class="mb-6">
          <%= render PlatformCore::Ui::FlashComponent.new(type: type, message: message) %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <% if respond_to?(:logged_in?) && logged_in? && PlatformCore::Modules.enabled?("feedback") && !request.path.start_with?("/feedback") %>
      <div class="fixed bottom-6 right-6 z-40 shadow-card">
        <%= render PlatformCore::Ui::ButtonComponent.new(
              variant: :primary,
              href: feedback.new_submission_path(page_url: request.fullpath),
              aria_label: "Give feedback about this page"
            ) do %>
          Feedback
        <% end %>
      </div>
    <% end %>

    <%= render PlatformCore::Ui::FooterComponent.new do |footer| %>
      <% footer.with_column(title: "Explore", links: PlatformCore::Modules.nav_modules.map { |m| [m.label, m.path] }) %>
      <% footer.with_column(title: "Account", links: [["Log in", "/login"], ["Sign up", "/signup"]]) %>
      <% footer.with_column(title: "About", links: [["About CitySocial", "/about"], ["Design system", "/design"]]) %>
    <% end %>
  </body>
</html>
