DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Sentry is initialized everywhere for consistent instrumentation, but only
# sends in the listed environments. Leave the DSN blank for local development.
SENTRY_DSN=
SENTRY_ENABLED_ENVIRONMENTS=production
# Optional for a deployment whose name differs from RAILS_ENV, such as staging.
# SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_API_TRACES_SAMPLE_RATE=0.25
SENTRY_JOB_TRACES_SAMPLE_RATE=0.05
# Relative to sampled traces: 0.1 here profiles about 1% of normal requests.
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=true
SENTRY_DB_QUERY_SOURCE_THRESHOLD_MS=100
SENTRY_TRACE_PROPAGATION_TARGETS=
SENTRY_SIDEKIQ_REPORT_AFTER_RETRIES=false
SENTRY_SIDEKIQ_REPORT_ONLY_DEAD_JOBS=false
SENTRY_DEBUG=false
# Optional overrides; the SDK otherwise reads the org from the DSN and the
# release from SENTRY_RELEASE, git, or Heroku runtime dyno metadata.
SENTRY_ORG_ID=
SENTRY_RELEASE=

# PostHog is disabled outside production unless POSTHOG_ENABLED=true. The
# project token is intentionally public; never expose a personal API key.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_ENABLED=true
